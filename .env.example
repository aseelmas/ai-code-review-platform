APP_ENV=development
# Comma-separated exact frontend origins. Production requires deployed HTTPS origins.
# If omitted in production, cross-origin browser access is disabled.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used by python -m backend. Hosting platforms may provide PORT automatically.
PORT=8000
LIMIT_CONCURRENCY=8

# Optional: static repository and diff analysis work without an API key.
OPENAI_API_KEY=
# Keep the existing model by default; override with a model your account supports.
OPENAI_MODEL=gpt-5.4
